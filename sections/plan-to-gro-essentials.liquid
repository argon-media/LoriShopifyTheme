{%- comment -%}
Plan to GRO Essentials landing page
Uses clean ptge- (plan-to-gro-essentials) BEM-like classes.
Reuses lob-styles.css for shared font-face declarations and base typography.
{%- endcomment -%}
{{ 'lob-styles.css' | asset_url | stylesheet_tag }}

<style>
  /* ===========================================================
     Plan to GRO Essentials - scoped styles
     =========================================================== */
  .ptge {
    --ptge-bg: #faf7f2;
    --ptge-ink: #1a1a1a;
    --ptge-muted: #4a4a4a;
    --ptge-gold: #e4b485;
    --ptge-line: #e6ddd0;
    --ptge-card: #fffaf3;
    --ff-heading: "Hatton-medium", "Hatton", "Cormorant Garamond", Georgia, serif;
    --ff-script: "Segatha", "Brittany Signature", "Allura", cursive;
    --ff-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background: var(--ptge-bg);
    color: var(--ptge-ink);
    font-family: var(--ff-body);
    font-size: 17px;
    line-height: 1.7;
    overflow-x: hidden;
  }
  .ptge *,
  .ptge *::before,
  .ptge *::after { box-sizing: border-box; }
  .ptge img { max-width: 100%; height: auto; display: block; }
  .ptge p { margin: 0 0 1em; color: var(--ptge-muted); }
  .ptge h1, .ptge h2, .ptge h3, .ptge h4, .ptge h5 {
    font-family: var(--ff-heading);
    color: var(--ptge-ink);
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 0.5em;
    letter-spacing: 0.5px;
  }
  .ptge h1 { font-size: clamp(2.2rem, 5vw, 4rem); text-transform: uppercase; }
  .ptge h2 { font-size: clamp(1.8rem, 3.6vw, 2.8rem); text-transform: uppercase; }
  .ptge h3 { font-size: clamp(1.4rem, 2.6vw, 2rem); }
  .ptge h4 { font-size: clamp(1.1rem, 2vw, 1.4rem); text-transform: uppercase; letter-spacing: 1.5px; }
  .ptge a { color: inherit; }

  .ptge__container {
    max-width: 1170px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .ptge__section {
    padding: 80px 0;
  }
  .ptge__section--tight { padding: 50px 0; }
  .ptge__section--lg { padding: 110px 0; }

  /* Buttons */
  .ptge__btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #000;
    color: #fff !important;
    text-decoration: none;
    padding: 18px 34px;
    font-family: var(--ff-body);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid #000;
    transition: background .25s ease, color .25s ease, transform .2s ease;
    cursor: pointer;
    margin-top: 14px;
  }
  .ptge__btn:hover {
    background: #fff;
    color: #000 !important;
  }
  .ptge__btn::after {
    content: "\2192";
    font-size: 16px;
    line-height: 1;
  }
  .ptge__btn--light {
    background: #fff;
    color: #000 !important;
    border-color: #fff;
  }
  .ptge__btn--light:hover {
    background: transparent;
    color: #fff !important;
    border-color: #fff;
  }
  .ptge__hide-mobile { display: inline-flex; }
  @media (max-width: 768px) {
    .ptge__hide-mobile { display: none; }
  }

  /* HERO */
  .ptge-hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    background: url("https://cdn.shopify.com/s/files/1/0797/0390/0415/files/branding-7.jpg") center/cover no-repeat;
    color: #fff;
    text-align: center;
  }
  .ptge-hero::before {
    content: "";
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.55);
  }
  .ptge-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
    padding: 90px 24px;
  }
  .ptge-hero h1 { color: #fff; margin-bottom: 24px; }
  .ptge-hero p { color: #f3eee5; font-size: 1.1rem; }
  .ptge-hero__sub { font-style: italic; max-width: 720px; margin: 0 auto 18px; }
  .ptge-hero__buttons { margin-top: 30px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  /* Two-column block */
  .ptge-two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .ptge-two--reverse { direction: rtl; }
  .ptge-two--reverse > * { direction: ltr; }
  @media (max-width: 860px) {
    .ptge-two { grid-template-columns: 1fr; gap: 36px; }
    .ptge-two--reverse { direction: ltr; }
  }
  .ptge-two__img img {
    width: 100%;
    border-radius: 4px;
    box-shadow: 0 20px 50px rgba(0,0,0,.12);
  }
  .ptge-two__text h2,
  .ptge-two__text h3 { margin-bottom: 16px; }
  .ptge-two__text h4 {
    color: var(--ptge-gold);
    margin: 18px 0 14px;
    font-size: 1rem;
    letter-spacing: 2px;
  }
  .ptge-two__sublabel {
    font-family: var(--ff-heading);
    font-size: 1.1rem;
    margin: 22px 0 10px;
    color: var(--ptge-ink);
    text-transform: none;
    letter-spacing: .5px;
  }
  .ptge-list {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
  }
  .ptge-list li {
    position: relative;
    padding: 8px 0 8px 26px;
    color: var(--ptge-muted);
    border-bottom: 1px solid var(--ptge-line);
  }
  .ptge-list li:last-child { border-bottom: none; }
  .ptge-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18px;
    width: 8px; height: 8px;
    background: var(--ptge-gold);
    border-radius: 50%;
  }

  /* DOES THIS RESONATE - dark image background */
  .ptge-resonate {
    position: relative;
    background: url("https://cdn.shopify.com/s/files/1/0797/0390/0415/files/branding-12.jpg") center/cover no-repeat fixed;
    color: #fff;
    text-align: center;
  }
  .ptge-resonate::before {
    content: "";
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.6);
  }
  .ptge-resonate__inner {
    position: relative; z-index: 2;
    padding: 100px 24px;
    max-width: 1170px;
    margin: 0 auto;
  }
  .ptge-resonate h2 { color: #fff; margin-bottom: 40px; }
  .ptge-resonate__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    text-align: left;
    margin-bottom: 30px;
  }
  @media (max-width: 800px) {
    .ptge-resonate__cols { grid-template-columns: 1fr; }
  }
  .ptge-resonate__cols ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ptge-resonate__cols li {
    color: #f5efe6;
    padding: 14px 0 14px 26px;
    position: relative;
    border-bottom: 1px solid rgba(255,255,255,0.18);
  }
  .ptge-resonate__cols li::before {
    content: "";
    position: absolute; left: 0; top: 22px;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--ptge-gold);
  }

  /* Quote + freebie */
  .ptge-quote {
    text-align: center;
    max-width: 880px;
    margin: 0 auto;
    padding: 0 24px;
    font-family: var(--ff-heading);
    font-style: italic;
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    line-height: 1.5;
    color: var(--ptge-ink);
  }
  .ptge-quote::before, .ptge-quote::after {
    content: "\201C";
    color: var(--ptge-gold);
    font-size: 2.4em;
    line-height: 0;
    vertical-align: -0.3em;
    margin: 0 .15em;
  }
  .ptge-quote::after { content: "\201D"; }

  .ptge-freebie {
    background: var(--ptge-card);
    border: 1px solid var(--ptge-line);
    border-radius: 6px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 50px;
  }
  @media (max-width: 800px) {
    .ptge-freebie { grid-template-columns: 1fr; }
  }
  .ptge-freebie__img { background: #ddd; }
  .ptge-freebie__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    min-height: 360px;
  }
  .ptge-freebie__body { padding: 50px 44px; }
  .ptge-freebie__label {
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--ptge-gold);
    font-weight: 600;
    margin-bottom: 12px;
    display: block;
  }

  /* Body life-needs section */
  .ptge-body__lead {
    font-family: var(--ff-heading);
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    line-height: 1.4;
    color: var(--ptge-ink);
    max-width: 880px;
    margin: 0 auto 24px;
    text-align: center;
  }
  .ptge-body__inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }
  .ptge-body__inner .ptge-list { text-align: left; }

  /* Two for-you cards */
  .ptge-foryou {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  @media (max-width: 800px) {
    .ptge-foryou { grid-template-columns: 1fr; }
  }
  .ptge-foryou__card {
    background: var(--ptge-card);
    border: 1px solid var(--ptge-line);
    border-radius: 6px;
    overflow: hidden;
  }
  .ptge-foryou__card img { width: 100%; height: 280px; object-fit: cover; }
  .ptge-foryou__body { padding: 36px 32px; }

  /* Testimonials */
  .ptge-testi {
    text-align: center;
  }
  .ptge-testi__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    margin-top: 40px;
  }
  @media (max-width: 1000px) {
    .ptge-testi__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .ptge-testi__grid { grid-template-columns: 1fr; }
  }
  .ptge-testi__card {
    background: #fff;
    border: 1px solid var(--ptge-line);
    padding: 30px 26px;
    border-radius: 4px;
    font-family: var(--ff-heading);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--ptge-ink);
    line-height: 1.55;
    text-align: left;
  }
  .ptge-testi__card::before {
    content: "\201C";
    display: block;
    color: var(--ptge-gold);
    font-size: 3rem;
    line-height: 0.8;
    margin-bottom: 8px;
  }
  .ptge-testi__tag {
    margin-top: 36px;
    letter-spacing: 4px;
    text-transform: uppercase;
    font-size: 14px;
    color: var(--ptge-gold);
    font-weight: 600;
  }

  /* Imagine */
  .ptge-imagine {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .ptge-imagine__intro {
    font-family: var(--ff-script);
    font-style: italic;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    color: var(--ptge-gold);
    margin-bottom: 18px;
  }
  .ptge-imagine__big {
    font-family: var(--ff-heading);
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    line-height: 1.4;
    color: var(--ptge-ink);
  }
  .ptge-imagine__big strong { font-weight: 600; }

  /* Dark overlay full-width section (Here's the thing / Resource for life) */
  .ptge-dark {
    position: relative;
    color: #fff;
    text-align: center;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .ptge-dark::before {
    content: "";
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.55);
  }
  .ptge-dark__inner {
    position: relative; z-index: 2;
    padding: 100px 24px;
    max-width: 920px;
    margin: 0 auto;
  }
  .ptge-dark h3 { color: #fff; margin-bottom: 22px; }
  .ptge-dark p { color: #f3eee5; }

  /* About Lori */
  .ptge-about__sub {
    color: var(--ptge-gold);
    font-family: var(--ff-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin: 6px 0 22px;
  }
  .ptge-about__italic { font-style: italic; }

  /* Big testimonial */
  .ptge-bigtesti {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .ptge-bigtesti h3 {
    font-family: var(--ff-heading);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    line-height: 1.35;
    margin-bottom: 28px;
    color: var(--ptge-ink);
  }
  .ptge-bigtesti__attrib {
    margin-top: 16px;
    color: var(--ptge-gold);
    letter-spacing: 2px;
    text-transform: uppercase;
    font-size: 13px;
    font-weight: 600;
  }

  /* Lifetime access */
  .ptge-lifetime {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .ptge-lifetime p {
    font-family: var(--ff-heading);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    line-height: 1.6;
    color: var(--ptge-ink);
  }

  /* How it works */
  .ptge-how {
    text-align: center;
  }
  .ptge-how__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 50px;
    text-align: left;
  }
  @media (max-width: 800px) {
    .ptge-how__cards { grid-template-columns: 1fr; }
  }
  .ptge-how__card {
    background: var(--ptge-card);
    border: 1px solid var(--ptge-line);
    border-radius: 6px;
    overflow: hidden;
  }
  .ptge-how__num {
    font-family: var(--ff-heading);
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    color: var(--ptge-gold);
    padding: 30px 36px 0;
    letter-spacing: 2px;
  }
  .ptge-how__body { padding: 8px 36px 36px; }
  .ptge-how__card img {
    width: 100%; height: 320px; object-fit: cover;
  }

  /* Pricing */
  .ptge-price { text-align: center; }
  .ptge-price h2 { margin-bottom: 50px; }
  .ptge-price__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    text-align: left;
  }
  @media (max-width: 1000px) {
    .ptge-price__grid { grid-template-columns: 1fr; max-width: 540px; margin: 0 auto; }
  }
  .ptge-price__card {
    background: #fff;
    border: 1px solid var(--ptge-line);
    border-radius: 6px;
    padding: 38px 30px;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .ptge-price__card--feat {
    border-color: var(--ptge-gold);
    box-shadow: 0 18px 40px rgba(228,180,133,0.25);
  }
  .ptge-price__feat-tag {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--ptge-gold);
    color: #fff;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 999px;
    font-weight: 600;
  }
  .ptge-price__label {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--ptge-gold);
    font-weight: 600;
    margin-bottom: 10px;
    display: block;
  }
  .ptge-price__card h3 {
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 6px;
  }
  .ptge-price__tagline {
    font-family: var(--ff-heading);
    font-style: italic;
    color: var(--ptge-muted);
    margin-bottom: 18px;
  }
  .ptge-price__list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
  }
  .ptge-price__list li {
    padding: 10px 0 10px 22px;
    position: relative;
    color: var(--ptge-muted);
    font-size: 0.95rem;
    border-bottom: 1px solid var(--ptge-line);
  }
  .ptge-price__list li:last-child { border-bottom: none; }
  .ptge-price__list li::before {
    content: "\2713";
    color: var(--ptge-gold);
    position: absolute;
    left: 0;
    top: 10px;
    font-weight: 700;
  }
  .ptge-price__card .ptge__btn { margin-top: auto; justify-content: center; }

  /* FAQ */
  .ptge-faq__accordion details {
    border-bottom: 1px solid var(--ptge-line);
    padding: 18px 0;
  }
  .ptge-faq__accordion summary {
    font-family: var(--ff-heading);
    font-size: 1.05rem;
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 30px;
    color: var(--ptge-ink);
  }
  .ptge-faq__accordion summary::-webkit-details-marker { display: none; }
  .ptge-faq__accordion summary::after {
    content: "+";
    position: absolute;
    right: 0;
    top: 0;
    font-size: 1.3rem;
    color: var(--ptge-gold);
    transition: transform .25s ease;
  }
  .ptge-faq__accordion details[open] summary::after {
    content: "\2212";
  }
  .ptge-faq__accordion details p {
    margin-top: 14px;
    color: var(--ptge-muted);
    font-size: 0.97rem;
  }
  .ptge-faq__cta {
    text-align: center;
    margin-top: 40px;
  }

  /* Section utilities */
  .ptge__center { text-align: center; }
  .ptge__btn-row { display: flex; justify-content: center; margin-top: 26px; }
  .ptge__bold { font-weight: 600; color: var(--ptge-ink); }
  .ptge__italic { font-style: italic; }

  @media (max-width: 600px) {
    .ptge { font-size: 16px; }
    .ptge__section { padding: 60px 0; }
    .ptge__section--lg { padding: 80px 0; }
    .ptge-freebie__body,
    .ptge-foryou__body,
    .ptge-how__body { padding: 28px 22px; }
    .ptge-how__num { padding: 22px 22px 0; }
  }
</style>

<div class="ptge">

  {%- comment -%} SECTION 1: HERO {%- endcomment -%}
  <section class="ptge-hero" id="top">
    <div class="ptge-hero__inner">
      <h1>Plan to GRO Essentials</h1>
      <p class="ptge-hero__sub">The overwhelm, mental clutter, unfinished goals, and constant feeling that life is happening TO you instead of WITH you will no longer have to be your normal.</p>
      <p>This is a guided journaling and planning experience designed to help you create clarity, structure, and intentional momentum around what matters most in this season of your life.</p>
      <p>You'll stop carrying your entire life mentally, create supportive rhythms, and finally become the woman who follows through on the life she truly desires.</p>
      <div class="ptge-hero__buttons">
        <a href="#pricing" class="ptge__btn">Yes, I'm Ready</a>
        <a href="#pricing" class="ptge__btn ptge__hide-mobile">I Need This!</a>
      </div>
    </div>
  </section>

  {%- comment -%} SECTION 2: STOP DRIFTING {%- endcomment -%}
  <section class="ptge__section">
    <div class="ptge__container">
      <div class="ptge-two">
        <div class="ptge-two__text">
          <h2>It's Time to Stop Drifting Through Your Life</h2>
          <h4>The simple system you need to create a life that feels clear, intentional, and aligned</h4>
          <p>Life moves fast. And there is nothing more exhausting than constantly feeling behind in your own life.</p>
          <p>If you've tried planners, routines, productivity hacks, mindset work, and constantly "starting over," and you STILL feel overwhelmed, mentally scattered, or inconsistent&hellip; then it's time to stop trying harder and start building systems that actually support your life.</p>
          <p class="ptge-two__sublabel">Women inside Plan to GRO Essentials often experience:</p>
          <ul class="ptge-list">
            <li>Finally feeling mentally clear again</li>
            <li>Consistently journaling and planning without overwhelm</li>
            <li>Following through on goals instead of constantly restarting</li>
            <li>Waking up with intention instead of immediately feeling behind</li>
            <li>Creating routines that actually support their real life</li>
            <li>Feeling calmer, more grounded, and more present throughout the week</li>
          </ul>
          <a href="#pricing" class="ptge__btn">Yes, I'm Ready!</a>
        </div>
        <div class="ptge-two__img">
          <img src="https://cdn.shopify.com/s/files/1/0797/0390/0415/files/branding-35.jpg" alt="Lori J Smith intentional living" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} SECTION 3: WE NEED TO TALK {%- endcomment -%}
  <section class="ptge__section" style="background:#f3ece1;">
    <div class="ptge__container">
      <div class="ptge-two ptge-two--reverse">
        <div class="ptge-two__text">
          <h3>We Need To Talk About Something&hellip;</h3>
          <p>Let me guess: you've tried planners, routines, productivity hacks, and "starting fresh" more times than you can count&hellip; but you STILL find yourself feeling mentally scattered, behind, overwhelmed, and wondering why life keeps feeling harder than it should.</p>
          <p>I got you! &#128521;</p>
          <p class="ptge__bold">Say hello to the simple journaling and planning framework designed to help you stop carrying your entire life mentally and finally create intentional structure that actually supports you.</p>
          <p class="ptge-two__sublabel">Did you know?</p>
          <p>Constant overwhelm is often connected to mental overload, unclear priorities, and trying to carry too many decisions at once.</p>
          <p class="ptge-two__sublabel">Did you know?</p>
          <p>Most women don't actually need more motivation &mdash; they need clarity, supportive rhythms, and systems that reduce decision fatigue.</p>
          <p class="ptge__italic ptge__bold">It's about time for you to experience peace, clarity, follow-through, and intentional living as your normal way of life.</p>
          <a href="#pricing" class="ptge__btn">Yes, I'm Ready!</a>
        </div>
        <div class="ptge-two__img">
          <img src="https://cdn.shopify.com/s/files/1/0797/0390/0415/files/branding-20.jpg" alt="Lori J Smith - planning rhythms" loading="lazy" />
        </div>
      </div>
