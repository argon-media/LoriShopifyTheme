{%- comment -%}
Plan to GRO Essentials landing page
Rebuilt with section-specific structural layouts (ptge- prefix).
Reuses lob-styles.css for shared font-face declarations (Hatton, Segatha).
{%- endcomment -%}
{{ 'lob-styles.css' | asset_url | stylesheet_tag }}

<style>
  /* ===========================================================
     Plan to GRO Essentials — scoped layout styles
     All CSS below is original to this section file.
     =========================================================== */
  .ptge {
    --ptge-bg: #faf7f2;
    --ptge-bg-2: #f3ece1;
    --ptge-ink: #2a2a2a;
    --ptge-muted: #2a2a2a;
    --ptge-gold: #a67738;
    --ptge-line: #e6ddd0;
    --ptge-card: #ffffff;
    --ptge-soft: #efe7da;
    --ff-heading: "Hatton-medium", "Hatton", "Cormorant Garamond", Georgia, serif;
    --ff-script: "Segatha", "Brittany Signature", "Allura", cursive;
    --ff-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background: var(--ptge-bg);
    color: var(--ptge-ink);
    font-family: var(--ff-body);
    font-size: 17px;
    line-height: 1.7;
    overflow-x: hidden;
  }
  .ptge *,
  .ptge *::before,
  .ptge *::after { box-sizing: border-box; }
  .ptge img { max-width: 100%; height: auto; display: block; }
  .ptge p { margin: 0 0 1em; color: #2a2a2a; font-size: 17px; line-height: 1.7; }
  .ptge h1, .ptge h2, .ptge h3, .ptge h4, .ptge h5 {
    font-family: var(--ff-heading);
    color: var(--ptge-ink);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 0.55em;
    letter-spacing: 0.05em;
    text-wrap: balance;
  }
  .ptge h1 { font-size: clamp(2.1rem, 4.4vw, 3.2rem); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500; }
  .ptge h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); text-transform: uppercase; letter-spacing: 0.03em; font-weight: 500; line-height: 1.14; }
  .ptge h3 { font-size: clamp(1.25rem, 2vw, 1.6rem); text-transform: uppercase; letter-spacing: 0.03em; font-weight: 500; }
  .ptge h4 { font-size: clamp(0.95rem, 1.5vw, 1.1rem); text-transform: uppercase; letter-spacing: 0.12em; }
  .ptge a { color: inherit; }
  .ptge p { text-wrap: pretty; }

  /* small uppercase eyebrow label (used above body sections) */
  .ptge .ptge-eyebrow {
    margin: 0 0 1em;
    color: #2a2a2a;
    font-size: 14px;
    line-height: 1.6;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
    font-family: var(--ff-body);
  }

  /* ----- shared buttons (unified) ----- */
  .ptge__btn,
  .ptge__btn--gold,
  .ptge__btn--light {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #1a1a1a;
    color: #fff !important;
    text-decoration: none;
    padding: 16px 36px;
    font-family: var(--ff-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border: none;
    border-radius: 0;
    transition: background .25s ease, color .25s ease, transform .2s ease;
    cursor: pointer;
  }
  .ptge__btn::after,
  .ptge__btn--gold::after,
  .ptge__btn--light::after {
    content: "\2192";
    font-size: 15px;
    line-height: 1;
  }
  .ptge__btn:hover,
  .ptge__btn--gold:hover,
  .ptge__btn--light:hover {
    background: #2a2a2a;
    color: #fff !important;
  }
  /* Inverted button for dark-bg sections */
  .ptge-hero .ptge__btn,
  .ptge-hero .ptge__btn--gold,
  .ptge-life .ptge__btn,
  .ptge-life .ptge__btn--gold,
  .ptge-seasons .ptge__btn,
  .ptge-seasons .ptge__btn--gold,
  .ptge-price .ptge__btn,
  .ptge-price .ptge__btn--gold {
    background: #fff;
    color: #1a1a1a !important;
  }
  .ptge-hero .ptge__btn:hover,
  .ptge-hero .ptge__btn--gold:hover,
  .ptge-life .ptge__btn:hover,
  .ptge-life .ptge__btn--gold:hover,
  .ptge-seasons .ptge__btn:hover,
  .ptge-seasons .ptge__btn--gold:hover,
  .ptge-price .ptge__btn:hover,
  .ptge-price .ptge__btn--gold:hover {
    background: #f0e9dc;
    color: #1a1a1a !important;
  }
  .ptge__btn-row { display: flex; justify-content: center; margin-top: 36px; }

  /* ----- shared card / image helpers ----- */
  .ptge__card {
    background: var(--ptge-card);
    border-radius: 0;
    border: 1px solid rgba(0,0,0,0.08);
    box-shadow: none;
  }
  .ptge__img-card {
    border-radius: 0;
    overflow: hidden;
    box-shadow: none;
    aspect-ratio: 4 / 5;
    background: #eadfce;
  }
  .ptge__img-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* shared section base */
  .ptge__section {
    padding: 100px 24px;
  }
  .ptge__section--soft { background: var(--ptge-soft); }
  .ptge__container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .ptge__centered-h2 {
    text-align: center;
    margin: 0 auto 60px;
    width: 100%;
    display: block;
    padding: 0;
    box-sizing: border-box;
    text-indent: 0.03em; /* optical centering vs trailing letter-spacing */
  }

  /* gold checkmark list */
  .ptge-checks {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
  }
  .ptge-checks li {
    position: relative;
    padding: 12px 0 12px 32px;
    color: #2a2a2a;
    line-height: 1.7;
    font-size: 17px;
  }
  .ptge-checks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18px;
    width: 16px; height: 16px;
    background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23a67738' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>") center/contain no-repeat;
  }

  /* ===========================================================
     1) HERO
     =========================================================== */
  .ptge-hero {
    position: relative;
    min-height: 72vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: url("https://cdn.shopify.com/s/files/1/0797/0390/0415/files/branding-70.jpg") center 30%/cover no-repeat;
    color: #fff;
    text-align: center;
    padding: 90px 24px 100px;
  }
  .ptge-hero::before {
    content: "";
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.5);
  }
  .ptge-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 760px;
    display: grid;
    justify-items: center;
  }
  .ptge-hero h1 {
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-indent: 0.06em; /* offset trailing letter-spacing so centered text is optically centered */
    font-weight: 500;
    margin-bottom: 20px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.35);
  }
  .ptge-hero__sub {
    color: #f3eee5 !important;
    font-size: 1.02rem;
    font-weight: 400;
    max-width: 620px;
    margin: 0 auto 14px;
    line-height: 1.6;
    text-shadow: 0 1px 6px rgba(0,0,0,0.35);
  }
  .ptge-hero__sub:last-of-type { margin-bottom: 26px; }
  /* Solid-fill brand button override for hero (gold #a67738) */
  .ptge-hero .ptge__btn,
  .ptge-hero .ptge__btn--gold {
    background: #a67738 !important;
    color: #fff !important;
    padding: 14px 32px;
    letter-spacing: 0.18em;
    font-size: 12px;
  }
  .ptge-hero .ptge__btn:hover,
  .ptge-hero .ptge__btn--gold:hover {
    background: #8d621d !important;
    color: #fff !important;
  }
  .ptge-hero .ptge__btn::after,
  .ptge-hero .ptge__btn--gold::after { content: none; }

  /* ===========================================================
     2) STOP DRIFTING — 7/5 text + headline card right
     =========================================================== */
  .ptge-drift__grid {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 80px;
    align-items: start;
  }
  .ptge-drift__text { max-width: 560px; }
  .ptge-drift__text h2 { margin-bottom: 22px; }
  .ptge-drift__lead {
    font-family: var(--ff-body);
    font-style: normal;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #a67738;
    font-weight: 600;
    margin-bottom: 26px;
    line-height: 1.5;
  }
  .ptge-drift__sublabel {
    font-family: var(--ff-body);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #2a2a2a;
    font-weight: 600;
    margin: 32px 0 14px;
  }
  .ptge-drift__card {
    background: #f3ece1;
    border: none;
    border-radius: 0;
    padding: 10px;
    text-align: center;
    box-shadow: none;
    min-height: 380px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 40px;
  }
  .ptge-drift__card-eyebrow {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #a67738;
    font-weight: 600;
    margin-bottom: 22px;
  }
  .ptge-drift__card-title {
    font-family: var(--ff-heading);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    color: var(--ptge-ink);
    line-height: 1.12;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 500;
    margin-bottom: 10px;
  }
  .ptge-drift__card-accent {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    color: #5a4a35;
    font-size: 1.15rem;
    line-height: 1.5;
  }
  .ptge-drift__card-sub {
    font-family: var(--ff-script);
    font-size: 1.6rem;
    color: #a67738;
    line-height: 1;
    margin-top: 6px;
  }

  /* ===========================================================
     3) WE NEED TO TALK — centered title + 2col img/text
     =========================================================== */
  .ptge-talk__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 80px;
    align-items: center;
  }
  .ptge-talk__text { text-align: center; }
  .ptge-talk__text p { max-width: 540px; margin-left: auto; margin-right: auto; }
  .ptge-talk__did {
    display: block;
    font-family: var(--ff-heading);
    font-size: 1.2rem;
    letter-spacing: 0;
    text-transform: none;
    font-style: italic;
    color: #a67738;
    font-weight: 500;
    margin: 28px 0 6px;
  }
  .ptge-talk__did + p { margin-top: 0; }
  .ptge-talk__close {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-size: 20px;
    font-weight: 500;
    color: #2a2a2a;
    max-width: 760px;
    margin: 40px auto 0;
    text-align: center;
    line-height: 1.55;
  }

  /* ===========================================================
     4) DOES THIS RESONATE — bullets left, image right
     =========================================================== */
  .ptge-reso__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 80px;
    align-items: center;
  }
  .ptge-reso__grid .ptge__img-card { aspect-ratio: 4 / 5; }

  /* ===========================================================
     5) QUOTE + FREEBIE
     =========================================================== */
  .ptge-quote {
font-family: var(--ff-heading);
    font-style: italic;
    color: var(--ptge-ink) !important;
    position: relative;
    font-size: 27px !important;
    text-align: center;
    line-height: 1.6em !important;
    padding: 0px;
    margin: 50px 0px 0px !important;
    max-width: 100%;
  }
  .ptge-quote::before,
  .ptge-quote::after {
    font-family: Georgia, serif;
    color: var(--ptge-gold);
    font-size: 4.5rem;
    line-height: 0;
    position: relative;
    top: 0.4em;
  }
  .ptge-quote::before { content: "\201C"; margin-right: 10px; }
  .ptge-quote::after  { content: "\201D"; margin-left: 10px; }

  .ptge-free {
    background: #efe7da;
    border-radius: 0;
    border: 1px solid rgba(0,0,0,0.08);
    overflow: hidden;
    display: grid;
    grid-template-columns: 4fr 8fr;
    box-shadow: none;
    max-width: 1200px;
    margin: 0 auto;
  }
  .ptge-free__img {
    position: relative;
    background: #ddd;
    min-height: 360px;
    border-radius: 0;
  }
  .ptge-free__img img {
    width: 100%; height: 100%;
    object-fit: cover;
    position: absolute; inset: 0;
  }
  .ptge-free__badge {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    background: #a67738;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    line-height: 1.1;
    padding: 4px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.2);
    z-index: 2;
  }
  .ptge-free__body {
    padding: 60px 50px;
  }
  .ptge-free__label {
    display: block;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a67738;
    font-weight: 700;
    margin-bottom: 14px;
  }

  /* ===========================================================
     6) WHAT LIFE NEEDS — dark
     =========================================================== */
  .ptge-life {
    position: relative;
    color: #fff;
    text-align: center;
    background: url("https://cdn.shopify.com/s/files/1/0797/0390/0415/files/branding-12.jpg") center/cover no-repeat;
    padding: 100px 24px;
  }
  .ptge-life::before {
    content: "";
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.6);
  }
  .ptge-life__inner {
    position: relative;
    z-index: 2;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  .background-f3ece1{    background: #f3ece1;     padding-bottom: 160px;
}
  .ptge-life__title {
    font-family: var(--ff-heading);
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 400;
    color: #fff;
    text-align: center;
    margin: 0 0 32px;
    letter-spacing: 0.02em;
    line-height: 1.12;
  }
  .ptge-life__lead {
    font-family: var(--ff-heading);
    font-size: clamp(1.25rem, 2.3vw, 1.7rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.35;
    margin-bottom: 28px;
  }
  .ptge-life__inner p { color: #f3eee5; }
  .ptge-life__bullets {
    list-style: none;
    padding: 0;
    margin: 28px auto;
    max-width: 720px;
    text-align: left;
  }
  .ptge-life__bullets li {
    position: relative;
    padding: 10px 0 10px 24px;
    color: #f3eee5;
    border-bottom: 1px solid rgba(255,255,255,0.16);
  }
  .ptge-life__bullets li:last-child { border-bottom: none; }
  .ptge-life__bullets li::before {
    content: "";
    position: absolute;
    left: 0; top: 20px;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--ptge-gold);
  }
  .ptge-life__close {
    font-family: var(--ff-heading);
    font-style: italic;
    font-size: 1.2rem;
    color: #fff;
    margin: 22px auto 30px;
  }

  /* ===========================================================
     7) TWO FOR-YOU BLOCKS — text only, vertical divider
     =========================================================== */
  .ptge-foryou {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 80px;
    border-radius: 0;
    border: none;
    box-shadow: none;
  }
  .ptge-foryou__block {
    position: relative;
  }
  .ptge-foryou__block + .ptge-foryou__block::before {
    content: none;
  }
  /* design-matched: thin divider under each item, checkmark aligned */
  .ptge-foryou .ptge-checks { margin: 0; }
  .ptge-foryou .ptge-checks li {
    padding: 18px 0 18px 34px;
    border-bottom: 1px solid rgba(166, 119, 56, 0.30);
  }
  .ptge-foryou .ptge-checks li::before { top: 24px; }
  .ptge-foryou__block h3 {
    margin-bottom: 30px;
    font-size: clamp(1.6rem, 2.7vw, 2.05rem);
    font-style: normal;
    font-family: var(--ff-heading);
    text-transform: none;
    letter-spacing: 0.01em;
    font-weight: 500;
    line-height: 1.2;
    color: #2a2a2a;
  }

  /* ===========================================================
     8) YOU WILL FEEL — white card, dashed dividers
     =========================================================== */
  .ptge-feel-section {
    position: relative;
    background-image: url('https://cdn.shopify.com/s/files/1/0797/0390/0415/files/branding-42.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: scroll;
  }
  .ptge-feel-section__overlay {
    position: absolute;
    inset: 0;
    background: rgba(40, 30, 20, 0.45);
    z-index: 1;
  }
  .ptge-feel-section .ptge__container {
    position: relative;
    z-index: 2;
  }

  .ptge-feel {
    position: relative;
    z-index: 3;
    border-radius: 0;
    border: 1px solid rgba(0,0,0,0.08);
    max-width: 960px;
    margin: -180px auto 0;
    box-shadow: none;
    text-align: center;

    background-color: #fff;
    padding: 80px 80px 50px;
    box-shadow: rgba(0, 0, 0, .25) 4px 4px 16px;
  }
  .ptge-feel > img {
    display: block;
    width: 230px;
    height: auto;
    margin: 0 auto -8px;
    border-radius: 0;
  }
  .ptge-feel h2 { margin-bottom: 36px; }
  .ptge-feel__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ptge-feel__list li {
    padding: 26px 10px;
    border-top: 1px solid rgba(166, 119, 56, 0.35);
    color: #2a2a2a;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    font-weight: 400;
  }
  .ptge-feel__list li:first-child { border-top: none; padding-top: 0; }
  .ptge-feel__list li:last-child  { padding-bottom: 0; }

  /* ===========================================================
     9) RESULTS — 3 phone-screenshot style cards
     =========================================================== */
  .ptge-results__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin: 60px auto 0;
    max-width: 1100px;
  }
  .ptge-results__card {
    background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 0;
    overflow: hidden;
    box-shadow: none;
    display: flex;
    flex-direction: column;
  }
  .ptge-results__img {
    aspect-ratio: 3 / 4;
    background: #eadfce;
    overflow: hidden;
    border-radius: 0;
  }
  .ptge-results__img img { width: 100%; height: 100%; object-fit: cover; }
  .ptge-results__quote {
    padding: 30px 28px 34px;
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-weight: 400;
    color: var(--ptge-ink);
    line-height: 1.55;
    font-size: 1rem;
    position: relative;
  }
  .ptge-results__quote::before {
    content: "\201C";
    display: block;
    font-family: Georgia, serif;
    color: var(--ptge-gold);
    font-size: 3.2rem;
    line-height: 0.7;
    margin-bottom: 10px;
    font-style: normal;
  }
  .ptge-results__tag {
    margin-top: 48px;
    margin-bottom: 0;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-size: 12px;
    color: #a67738;
    font-weight: 600;
    text-align: center;
  }

  /* ===========================================================
     11) IMAGINE / I CAN HELP — 7/5 text + image right
     =========================================================== */
  .ptge-help__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 80px;
    align-items: center;
  }
  .ptge-help__imagine {
    font-family: var(--ff-heading);
    font-style: italic;
    color: var(--ptge-ink);
    font-weight: 500;
    font-size: clamp(1.3rem, 2.1vw, 1.65rem);
    margin-bottom: 14px;
    letter-spacing: 0;
  }
  .ptge .ptge-help__big {
    font-family: var(--ff-heading);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(1.45rem, 2.5vw, 1.95rem);
    line-height: 1.35;
    letter-spacing: 0.01em;
    text-transform: none;
    color: #2a2a2a;
    margin-bottom: 36px;
  }
  .ptge-help__big strong { font-style: italic; font-weight: 500; }
  .ptge-help__divider {
    width: 48px;
    height: 1px;
    background: var(--ptge-gold);
    margin: 28px 0 32px;
  }

  /* ===========================================================
     12) HERE'S THE THING — 5/7 image left, text right
     13) LISTEN TO THIS — 7/5 text left, image right
     14) ABOUT LORI — 7/5 text left, image right
     15) BIG TESTIMONIAL — 5/7 image left, quote right
     =========================================================== */
  .ptge-split {
    display: grid;
    gap: 70px;
    align-items: center;
  }
  .ptge-split--5-7 { grid-template-columns: 5fr 7fr; }
  .ptge-split--7-5 { grid-template-columns: 7fr 5fr; }

  .ptge-about__sub {
